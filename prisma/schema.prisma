generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  goodsId         String   @map("goods_id")
  url             String   @default("")
  thresholdPrice  Float    @map("threshold_price")
  fetcher         String   @default("mock")
  active          Boolean  @default(true)

  // Snapshot of the most recent check (denormalized for fast dashboard render).
  lastPrice         Float?    @map("last_price")
  lastOriginalPrice Float?    @map("last_original_price")
  lastInStock       Boolean   @default(true) @map("last_in_stock")
  lastCheckedAt     DateTime? @map("last_checked_at")
  lastError         String?   @map("last_error")

  // Alert de-duplication: true while price has been continuously at/below
  // threshold. We only fire an alert on the transition into this state.
  isBelowThreshold Boolean  @default(false) @map("is_below_threshold")

  createdAt DateTime @default(now()) @map("created_at")

  history PriceHistory[]
  alerts  AlertLog[]

  @@index([goodsId])
  @@map("products")
}

model PriceHistory {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  price         Float?
  originalPrice Float?   @map("original_price")
  inStock       Boolean  @default(true) @map("in_stock")
  ok            Boolean  @default(true)
  error         String?
  fetchedAt     DateTime @default(now()) @map("fetched_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("price_history")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model AlertLog {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  price          Float
  thresholdPrice Float    @map("threshold_price")
  channels       String   @default("")
  message        String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("alert_log")
}
