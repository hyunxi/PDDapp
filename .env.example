# Copy to .env and edit. All values shown are defaults.

# --- Core ---
DATABASE_URL=sqlite:///./pddapp.db
# How often the background scheduler re-checks every active product (seconds).
CHECK_INTERVAL_SECONDS=300
# Default fetcher used for new products: "mock" or "pdd".
DEFAULT_FETCHER=mock
# Currency symbol shown in the UI (Pinduoduo prices are CNY).
CURRENCY_SYMBOL=¥

# --- Console / file alerts ---
CONSOLE_ENABLED=true
ALERT_LOG_FILE=alerts.log

# --- Webhook alerts (Discord/Slack/custom) ---
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# --- Email alerts (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
